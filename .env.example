# Copy to apps/api/.env. Never commit real values.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://haire_app:haire_app_dev@localhost:5432/haire
MIGRATION_DATABASE_URL=postgresql://haire_owner:haire_owner_dev@localhost:5432/haire
REDIS_URL=redis://localhost:6379
# Trusted proxy hops in front of the API. 0 for local development; 1 when the web app (or one load balancer) calls the API.
TRUST_PROXY=0
# 'mock' is a development-only keyword matcher; the app refuses to start in production with it.
MODEL_PROVIDER=mock
